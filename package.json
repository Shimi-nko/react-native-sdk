{
  "name": "@usercentrics/react-native-sdk",
  "version": "2.18.6",
  "description": "Usercentrics SDK",
  "homepage": "https://usercentrics.com",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "author": "Usercentrics <developer@usercentrics.com>",
  "iosPackageName": "react-native-usercentrics",
  "iosPackageVersion": "2.18.6",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prepack": "bob build",
    "test": "jest src/__tests__/index.test.ts"
  },
  "devDependencies": {
    "@babel/core": "7.26.9",
    "@babel/runtime": "7.26.9",
    "@biomejs/biome": "1.9.4",
    "@react-native-community/eslint-config": "3.2.0",
    "@types/jest": "^27.0.1",
    "@types/react-test-renderer": "18.3.1",
    "babel-jest": "29.7.0",
    "eslint": "9.20.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jest": "29.7.0",
    "metro-react-native-babel-preset": "0.77.0",
    "react": "18.3.1",
    "react-native": "^0.77.1",
    "react-native-builder-bob": "^0.37.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "directories": {
    "example": "example",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Usercentrics/react-native-sdk"
  },
  "bugs": {
    "url": "https://github.com/Usercentrics/react-native-sdk/issues"
  },
  "codegenConfig": {
    "name": "UsercentricsSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.usercentrics.reactnativeusercentrics"
    },
    "includesGeneratedCode": true
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ]
}
